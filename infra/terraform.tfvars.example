# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Nothing secret belongs here. Secret Manager values are added out of band with
# `gcloud secrets versions add`, and the sweep path is generated by Terraform.

# Project IDs are globally unique, so "titelheld" may well be taken.
project_id = "titelheld-XXXXXX"

# The XXXXXX-XXXXXX-XXXXXX form, from `gcloud billing accounts list`.
billing_account = "000000-000000-000000"

# Empty on the first apply; Cloud Run mints the URL. Read it from the
# service_url output and set it here for the second apply.
base_url = ""
