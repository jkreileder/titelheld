{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "automergeStrategy": "squash",
    "customManagers": [
        {
            "customType": "regex",
            "datasourceTemplate": "go",
            "depNameTemplate": "github.com/golangci/golangci-lint/v2",
            "description": "Keep the golangci-lint version pinned in the Makefile current - it is run via `go run <module>@<version>`, so no standard manager sees it.",
            "managerFilePatterns": [
                "Makefile"
            ],
            "matchStrings": [
                "GOLANGCI_LINT_VERSION := (?<currentValue>v[^\\s]+)"
            ]
        },
        {
            "customType": "regex",
            "datasourceTemplate": "go",
            "depNameTemplate": "github.com/golangci/golangci-lint/v2",
            "description": "Keep the golangci-lint version passed to golangci/golangci-lint-action in step with the Makefile pin.",
            "managerFilePatterns": [
                ".github/workflows/go.yaml"
            ],
            "matchStrings": [
                "\\n\\s+version: (?<currentValue>v[0-9][^\\s]*)"
            ]
        },
        {
            "customType": "regex",
            "datasourceTemplate": "go",
            "depNameTemplate": "golang.org/x/vuln",
            "description": "Keep the govulncheck version pinned in the Makefile current - it is run via `go run <module>@<version>`, so no standard manager sees it.",
            "managerFilePatterns": [
                "Makefile"
            ],
            "matchStrings": [
                "GOVULNCHECK_VERSION := (?<currentValue>v[^\\s]+)"
            ]
        },
        {
            "customType": "regex",
            "datasourceTemplate": "go",
            "depNameTemplate": "golang.org/x/vuln",
            "description": "Keep the govulncheck version used by the workflow in step with the Makefile pin.",
            "managerFilePatterns": [
                ".github/workflows/go.yaml"
            ],
            "matchStrings": [
                "govulncheck@(?<currentValue>v[^\\s]+)"
            ]
        },
        {
            "customType": "regex",
            "datasourceTemplate": "go",
            "depNameTemplate": "gotest.tools/gotestsum",
            "description": "Keep the gotestsum version pinned in the Makefile current - it is run via `go run <module>@<version>`, so no standard manager sees it.",
            "managerFilePatterns": [
                "Makefile"
            ],
            "matchStrings": [
                "GOTESTSUM_VERSION := (?<currentValue>v[^\\s]+)"
            ]
        },
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "depNameTemplate": "gcr.io/google.com/cloudsdktool/google-cloud-cli",
            "description": "Pin the Firestore emulator image by tag + digest. The same pin appears in the workflow and in docs/firestore-iam.md, so a local run and CI test the same emulator; both are updated together.",
            "managerFilePatterns": [
                ".github/workflows/go.yaml",
                "docs/firestore-iam.md"
            ],
            "matchStrings": [
                "gcr\\.io/google\\.com/cloudsdktool/google-cloud-cli:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ]
        },
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "depNameTemplate": "ghcr.io/trufflesecurity/trufflehog",
            "description": "Pin the TruffleHog scanner image (version input of trufflesecurity/trufflehog) by version + digest. The action pin alone leaves the image floating.",
            "managerFilePatterns": [
                ".github/workflows/trufflehog.yaml"
            ],
            "matchStrings": [
                "version: (?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ]
        },
        {
            "customType": "regex",
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "terraform-linters/tflint-ruleset-google",
            "description": "Keep the tflint google ruleset current; Renovate has no manager for tflint plugin pins.",
            "extractVersionTemplate": "^v(?<version>.*)$",
            "managerFilePatterns": [
                "infra/.tflint.hcl"
            ],
            "matchStrings": [
                "version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\n\\s*source\\s*=\\s*\"github.com/terraform-linters/tflint-ruleset-google\""
            ]
        }
    ],
    "extends": [
        "config:best-practices",
        ":gitSignOff",
        "schedule:earlyMondays",
        "schedule:automergeDaily",
        ":enablePreCommit"
    ],
    "internalChecksFilter": "strict",
    "labels": [
        "dependencies"
    ],
    "minimumReleaseAge": "3 days",
    "osvVulnerabilityAlerts": true,
    "packageRules": [
        {
            "automerge": true,
            "description": "Group GitHub Actions minor/patch into one PR; majors get their own PR.",
            "groupName": "github-actions",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        },
        {
            "automerge": true,
            "description": "Group all pre-commit hook updates into one automerged PR - lint/validate-only tooling that never ships and is fully CI-gated.",
            "groupName": "pre-commit",
            "matchManagers": [
                "pre-commit"
            ]
        },
        {
            "automerge": true,
            "description": "Go dev tooling run via `go run <module>@<version>` (golangci-lint, govulncheck): never shipped, fully CI-gated.",
            "groupName": "go-tooling",
            "matchManagers": [
                "custom.regex"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        },
        {
            "automerge": false,
            "description": "Runtime Go module dependencies: grouped, manual review. This service writes to a live Strava account, so a dependency bump is never unattended.",
            "groupName": "go modules",
            "matchManagers": [
                "gomod"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        },
        {
            "automerge": false,
            "description": "Renovate disables indirect Go updates by default, which would leave most of the Firestore dependency tree - grpc, the google-api stack, golang.org/x/* - unwatched. They are compiled into the binary and are exactly where govulncheck findings surface, so they are updated too, grouped and reviewed by hand like the direct ones.",
            "enabled": true,
            "groupName": "go modules (indirect)",
            "matchDepTypes": [
                "indirect"
            ],
            "matchManagers": [
                "gomod"
            ]
        },
        {
            "automerge": true,
            "description": "Patch releases of the Go toolchain itself (the `go` directive in go.mod) carry the security fixes; the spec requires staying on latest stable. Minors and majors fall through to manual review.",
            "matchDatasources": [
                "golang-version"
            ],
            "matchDepNames": [
                "go"
            ],
            "matchUpdateTypes": [
                "patch"
            ]
        },
        {
            "automerge": true,
            "description": "Automerge digest-only refreshes and initial digest pins (actions + images).",
            "groupName": "digests",
            "matchUpdateTypes": [
                "digest",
                "pin"
            ]
        },
        {
            "automerge": false,
            "description": "GitHub Actions digest refreshes are reviewed by hand: minimumReleaseAge cannot hold them back. The github-tags datasource ages a digest against the matched version's original release date, so an action tag force-pushed to new commits clears the 3-day check immediately and would otherwise automerge within hours.",
            "groupName": "github-actions-digests",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "digest"
            ]
        },
        {
            "automerge": false,
            "description": "Terraform providers and modules: grouped, manual review. They describe live infrastructure, and a plan is only as trustworthy as the provider that produced it.",
            "groupName": "terraform",
            "matchManagers": [
                "terraform"
            ]
        },
        {
            "automerge": true,
            "description": "Container base images for the runtime image: grouped and automerged on minor/patch, because CI builds and starts the image on every pull request.",
            "groupName": "docker",
            "matchManagers": [
                "dockerfile"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        }
    ],
    "postUpdateOptions": [
        "gomodTidy"
    ],
    "semanticCommits": "enabled",
    "timezone": "Europe/Berlin",
    "vulnerabilityAlerts": {
        "labels": [
            "security"
        ]
    }
}
