# Local configuration (may hold athlete config or tokens)
config.yaml
config.local.yaml

# Go build output
/bin
/dist
*.exe

# Test and coverage reports
coverage.out
coverage.html
test-results.xml

# Local credentials and environment. Secrets belong outside the tree entirely
# (see the README); these entries exist so a stray file cannot be committed.
.env
.envrc
*.pem
service-account*.json

# OS artifacts
.DS_Store

# IDE and editor files
.idea
*.swp
*~
\#*#
.#*
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude/settings.local.json

# Build handoff/spec: personal working document, not published.
HANDOFF.md

# Terraform. The lock file is committed on purpose: it is what pins provider
# versions for everyone. State never lands here — it lives in the GCS bucket.
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
